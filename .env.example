# Database
DATABASE_URL="postgresql://username:password@localhost:5432/job_assistant"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Encryption for user-saved API keys (required, 32+ characters).
# Do not use the historical default "default-dev-encryption-key-32-chars".
ENCRYPTION_KEY="replace-with-a-32-character-or-longer-secret"

# Seed admin password (`npm run db:seed`). Override in any shared environment.
# If unset in local development, seed uses: local-dev-admin-ChangeMe!
ADMIN_PASSWORD="local-dev-admin-ChangeMe!"

# AI providers. User-saved keys in Settings take precedence over these system keys.
OPENAI_API_KEY="your-openai-api-key"
GOOGLE_AI_API_KEY="your-google-ai-api-key"
GOOGLE_API_KEY="your-google-api-key"
USE_GOOGLE_AI="false"
# ANTHROPIC_API_KEY="your-anthropic-api-key"
# DEEPSEEK_API_KEY="your-deepseek-api-key"

# Password reset: development-only path that returns a reset link in the API
# response when transactional email is not configured. Never enable in production.
ALLOW_DEV_PASSWORD_RESET="true"

# File Storage (Choose one)
# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# OR Supabase Storage
# Storage Provider Configuration
# Set to 'aws', 'supabase', or 'local'
STORAGE_PROVIDER=local

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your-bucket-name

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key
SUPABASE_BUCKET=documents
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
S3_BUCKET=your_s3_bucket
S3_REGION=eu-central-1

# Local Storage Configuration (for development)
# Files are served through the authenticated /api/storage/file route, not a public /storage mount.
LOCAL_STORAGE_PATH=./storage

# MCP server (OAuth 2.1 resource server). See docs/mcp.md
MCP_RESOURCE_URL="https://your-app.example.com/api/mcp"
OAUTH_ISSUER="https://your-authorization-server.example.com"
# OAUTH_JWKS_URI defaults to <OAUTH_ISSUER>/.well-known/jwks.json
# MCP_MAX_GENERATIONS=5
